{
  "mailer_subjects_confirmation": "Confirm your Virtual Hookah account",
  "mailer_templates_confirmation_content": "<div style=\"background:#0b0c10;padding:32px 12px;font-family:-apple-system,Segoe UI,Roboto,sans-serif\">\n<div style=\"max-width:480px;margin:0 auto;background:#14151b;border:1px solid #262834;border-radius:16px;padding:28px;color:#ecedf3\">\n<div style=\"font-size:28px\">🫧</div>\n<h1 style=\"font-size:22px;margin:8px 0 6px;color:#ecedf3\">Welcome to Virtual Hookah!</h1>\n<p style=\"font-size:15px;line-height:1.5;color:#c9cbd8;margin:0 0 22px\">Confirm your email to save scores, add friends and play online.</p>\n<a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#8fb3ff;color:#0b0f1c;text-decoration:none;font-weight:700;padding:12px 22px;border-radius:10px\">Confirm my email</a>\n<p style=\"font-size:12px;line-height:1.5;color:#8b8ea0;margin:22px 0 0\">If you didn't sign up, you can ignore this email.</p>\n<p style=\"font-size:12px;color:#8b8ea0;margin:14px 0 0\">Virtual Hookah · just for fun, no smoking involved.</p>\n</div></div>",
  "mailer_subjects_recovery": "Reset your Virtual Hookah password",
  "mailer_templates_recovery_content": "<div style=\"background:#0b0c10;padding:32px 12px;font-family:-apple-system,Segoe UI,Roboto,sans-serif\">\n<div style=\"max-width:480px;margin:0 auto;background:#14151b;border:1px solid #262834;border-radius:16px;padding:28px;color:#ecedf3\">\n<div style=\"font-size:28px\">🫧</div>\n<h1 style=\"font-size:22px;margin:8px 0 6px;color:#ecedf3\">Reset your password</h1>\n<p style=\"font-size:15px;line-height:1.5;color:#c9cbd8;margin:0 0 22px\">Someone (hopefully you) asked to reset your Virtual Hookah password.</p>\n<a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#8fb3ff;color:#0b0f1c;text-decoration:none;font-weight:700;padding:12px 22px;border-radius:10px\">Choose a new password</a>\n<p style=\"font-size:12px;line-height:1.5;color:#8b8ea0;margin:22px 0 0\">If you didn't ask for this, ignore this email: your password stays the same.</p>\n<p style=\"font-size:12px;color:#8b8ea0;margin:14px 0 0\">Virtual Hookah · just for fun, no smoking involved.</p>\n</div></div>",
  "mailer_subjects_email_change": "Confirm your new email for Virtual Hookah",
  "mailer_templates_email_change_content": "<div style=\"background:#0b0c10;padding:32px 12px;font-family:-apple-system,Segoe UI,Roboto,sans-serif\">\n<div style=\"max-width:480px;margin:0 auto;background:#14151b;border:1px solid #262834;border-radius:16px;padding:28px;color:#ecedf3\">\n<div style=\"font-size:28px\">🫧</div>\n<h1 style=\"font-size:22px;margin:8px 0 6px;color:#ecedf3\">Confirm your new email</h1>\n<p style=\"font-size:15px;line-height:1.5;color:#c9cbd8;margin:0 0 22px\">Confirm this address to use it for your Virtual Hookah account.</p>\n<a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#8fb3ff;color:#0b0f1c;text-decoration:none;font-weight:700;padding:12px 22px;border-radius:10px\">Confirm new email</a>\n<p style=\"font-size:12px;line-height:1.5;color:#8b8ea0;margin:22px 0 0\">If you didn't ask for this, ignore this email.</p>\n<p style=\"font-size:12px;color:#8b8ea0;margin:14px 0 0\">Virtual Hookah · just for fun, no smoking involved.</p>\n</div></div>",
  "mailer_subjects_magic_link": "Your Virtual Hookah sign-in link",
  "mailer_templates_magic_link_content": "<div style=\"background:#0b0c10;padding:32px 12px;font-family:-apple-system,Segoe UI,Roboto,sans-serif\">\n<div style=\"max-width:480px;margin:0 auto;background:#14151b;border:1px solid #262834;border-radius:16px;padding:28px;color:#ecedf3\">\n<div style=\"font-size:28px\">🫧</div>\n<h1 style=\"font-size:22px;margin:8px 0 6px;color:#ecedf3\">Sign in to Virtual Hookah</h1>\n<p style=\"font-size:15px;line-height:1.5;color:#c9cbd8;margin:0 0 22px\">Tap the button to sign in.</p>\n<a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#8fb3ff;color:#0b0f1c;text-decoration:none;font-weight:700;padding:12px 22px;border-radius:10px\">Sign in</a>\n<p style=\"font-size:12px;line-height:1.5;color:#8b8ea0;margin:22px 0 0\">If you didn't ask for this, ignore this email.</p>\n<p style=\"font-size:12px;color:#8b8ea0;margin:14px 0 0\">Virtual Hookah · just for fun, no smoking involved.</p>\n</div></div>"
